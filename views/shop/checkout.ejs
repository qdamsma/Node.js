<%- include('../includes/head.ejs') %>
    <link rel="stylesheet" href="/css/cart.css">
    </head>

    <body>
        <%- include('../includes/navigation.ejs') %>
            <main>
                <ul class="cart__item-list">
                    <% products.forEach(p=> { %>
                        <li class="cart__item">
                            <h1><%= p.productId.title %></h1>
                            <h2>Quantity: <%= p.quantity %></h2>
                        </li>
                    <% }) %>
                </ul>
                <div>
                    <h2>Total: <%= totalSum %></h2>
                </div>
                <div class="centered">
                    <button id="order-btn" class="btn">ORDER</button>
                </div>

                <!-- Waarschuwingsmodal simpel en snel gemaakt met claude-->
                <div id="test-modal" class="modal-backdrop" style="display:none;">
                    <div class="modal">
                        <h2 class="modal__title">Waarschuwing: Testproject</h2>
                        <p class="modal__text">Dit is een testproject. Gebruik <strong>geen echte betaalgegevens</strong>.</p>
                        <p class="modal__text">Gebruik dit testkaartnummer bij Stripe:</p>
                        <code class="modal__card">4242 4242 4242 4242</code>
                        <p class="modal__subtext">Vervaldatum: elke datum in de toekomst &nbsp;|&nbsp; CVC: elk 3-cijferig getal</p>
                        <div class="modal__actions">
                            <button id="modal-cancel" class="btn btn--ghost">Annuleren</button>
                            <button id="modal-confirm" class="btn btn--primary">Doorgaan naar betaling</button>
                        </div>
                    </div>
                </div>

                <script src="https://js.stripe.com/v3"></script>
                <script>
                    var stripe = Stripe('<%= stripePublishableKey %>');
                    var orderBtn = document.getElementById('order-btn');
                    var modal = document.getElementById('test-modal');
                    var cancelBtn = document.getElementById('modal-cancel');
                    var confirmBtn = document.getElementById('modal-confirm');

                    orderBtn.addEventListener('click', function() {
                        modal.style.display = 'flex';
                    });

                    cancelBtn.addEventListener('click', function() {
                        modal.style.display = 'none';
                    });

                    confirmBtn.addEventListener('click', function() {
                        modal.style.display = 'none';
                        stripe.redirectToCheckout({ sessionId: '<%= sessionId %>' });
                    });

                    modal.addEventListener('click', function(e) {
                        if (e.target === modal) modal.style.display = 'none';
                    });
                </script>
            </main>
            <%- include('../includes/end.ejs') %>
