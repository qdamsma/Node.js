<%- include('../includes/head.ejs') %>
    <link rel="stylesheet" href="/css/product.css">
    </head>

    <body>
        <%- include('../includes/navigation.ejs') %>
        <main>
            <div class="detail-card">
                <div class="detail-card__image">
                    <img src="/<%= product.imageUrl %>" alt="<%= product.title %>">
                </div>
                <div class="detail-card__info">
                    <h1 class="detail-card__title"><%= product.title %></h1>
                    <p class="detail-card__price">€<%= product.price %></p>
                    <p class="detail-card__description"><%= product.description %></p>
                    <% if(isAuthenticated) { %>
                        <%- include('../includes/add-to-cart.ejs', {product: product}) %>
                    <% } else { %>
                        <a href="/login" class="btn">Log in om te kopen</a>
                    <% } %>
                </div>
            </div>
        </main>
        <%- include('../includes/end.ejs') %>
