<%- include('../includes/head.ejs') %>
    <link rel="stylesheet" href="/css/forms.css">
    <link rel="stylesheet" href="/css/auth.css">
    </head>

    <body>
        <%- include('../includes/navigation.ejs') %>

            <main>
                <form class="login-form" action="/signup" method="POST" novalidate>
                    <div class="form-control">
                        <label for="email">E-Mail</label>
                        <% const emailError=validationErrors.find(e=> e.path === 'email') %>
                            <input class="<%= emailError ? 'invalid' : '' %>" type="email" name="email" id="email"
                                value="<%= oldInput.email %>">
                            <% if (emailError) { %>
                                <span class="field-error">
                                    <%= emailError.msg %>
                                </span>
                                <% } %>
                    </div>
                    <div class="form-control">
                        <label for="password">Password</label>
                        <% const passwordError=validationErrors.find(e=> e.path === 'password') %>
                            <input class="<%= passwordError ? 'invalid' : '' %>" type="password" name="password"
                                id="password">
                            <% if (passwordError) { %>
                                <span class="field-error">
                                    <%= passwordError.msg %>
                                </span>
                                <% } %>
                    </div>

                    <div class="form-control">
                        <label for="confirmPassword">Confirm Password</label>
                        <% const confirmError=validationErrors.find(e=> e.path === 'confirmPassword') %>
                            <input class="<%= confirmError ? 'invalid' : '' %>" type="password" name="confirmPassword"
                                id="confirmPassword">
                            <% if (confirmError) { %>
                                <span class="field-error">
                                    <%= confirmError.msg %>
                                </span>
                                <% } %>
                    </div>
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="btn" type="submit">Signup</button>
                </form>
            </main>
            <%- include('../includes/end.ejs') %>